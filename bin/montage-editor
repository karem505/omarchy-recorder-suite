#!/usr/bin/env bash
# Open a video in the Montage editor (a standalone Quickshell app at
# ~/.config/quickshell/montage). Probes the video here so the QML side gets
# resolution/duration/audio facts through the environment instead of racing
# MediaPlayer metadata. Multiple instances are fine — each gets its own
# thumbnail directory.

if [[ -z ${1:-} || ! -f $1 ]]; then
  omarchy-notification-send -u critical -t 4000 "Montage" "No such video: ${1:-<none>}"
  echo "usage: montage-editor <video-file>" >&2
  exit 1
fi

f=$(realpath "$1")

probe=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "$f")
W=${probe%%x*}
H=${probe##*x}
dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$f")
audio=$(ffprobe -v error -select_streams a -show_entries stream=codec_type -of csv=p=0 "$f" | head -1)

exec env MONTAGE_FILE="$f" MONTAGE_W="$W" MONTAGE_H="$H" \
  MONTAGE_DUR="$dur" MONTAGE_HAS_AUDIO="${audio:+1}" \
  MONTAGE_THUMBS="${XDG_RUNTIME_DIR:-/tmp}/montage-thumbs-$$" \
  quickshell -p "$HOME/.config/quickshell/montage"
